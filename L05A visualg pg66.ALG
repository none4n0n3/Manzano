Algoritmo "L05A"
// Disciplina: Lógica de Programação
// Autor(a)  : Alexsandra Alves Tarasiuk
// Descrição  : Apresenta os quadrados dos números inteiros de 15 a 200 utilizando a estrutura para.
var
  I, QUADRADO : inteiro
inicio
  para I de 15 ate 200 faca
    QUADRADO <- I * I
    escreval(I, " ao quadrado = ", QUADRADO)
  fimpara
fimalgoritmo